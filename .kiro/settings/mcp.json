{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.7.0"],
      "env": {},
      "disabled": false,
      "autoApprove": ["resolve-library-id", "query-docs"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85"],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "ghost-lab": {
      "command": "pnpm",
      "args": ["-s", "mcp:ghost-lab"],
      "env": {},
      "disabled": true,
      "autoApprove": ["parse_ride", "find_overlap", "gap_at", "render_narration"]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "disabled": true,
      "autoApprove": []
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "disabled": true,
      "autoApprove": []
    }
  }
}
