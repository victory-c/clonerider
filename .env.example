# Copy to .env.local for local dev. Real values are never committed.

# AI Gateway (on Vercel, OIDC can replace the key)
AI_GATEWAY_API_KEY=
NARRATOR_MODEL=anthropic/claude-haiku-5.5
# TTS_MODEL options include openai/tts-1, openai/tts-1-hd, elevenlabs/eleven-flash-v2.5 (see tech.md S3b)
TTS_MODEL=openai/tts-1
TTS_VOICE=

# Kill switch: false = always use the deterministic template narrator
NARRATOR_ENABLED=true
NARRATE_RATE_LIMIT_PER_HOUR=10

# Local only — fixture privacy test. "lat,lon". Never commit real values.
PRIVATE_HOME_LATLON=
PRIVATE_WORK_LATLON=
