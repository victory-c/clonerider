# Copy to .env.local for local dev. Real values are never committed.

# Claude API (direct, via @ai-sdk/anthropic). Set the same var in Vercel → Project → Settings → Environment Variables.
# Set a monthly spend limit in the Anthropic Console: the app must stay up until Jan 29 2027.
ANTHROPIC_API_KEY=
NARRATOR_MODEL=claude-haiku-5-5

# Kill switch: false = always use the deterministic template narrator
NARRATOR_ENABLED=true
NARRATE_RATE_LIMIT_PER_HOUR=10

# Local only — fixture privacy test. "lat,lon". Never commit real values.
PRIVATE_HOME_LATLON=
PRIVATE_WORK_LATLON=
