# ------------------------------------------------------------------
# IMPORTANT (Kiroween rule): the Kiro project directory at the repo
# root MUST be committed. Never add it, or any of its subfolders,
# to this file. A compliance hook checks this.
# ------------------------------------------------------------------

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# env files (keep .env.example committed)
.env
.env*.local
.env.development
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw, UNSCRUBBED ride files pulled for development.
# Only privacy-scrubbed fixtures under tests/fixtures/ and public/samples/ are committed.
/fixtures-raw/
*.raw.fit
*.raw.gpx

# local recordings / video editing scratch
/recordings/
*.mov
*.mp4
!public/samples/**/*.mp4

# editor
.vscode/*
!.vscode/extensions.json
.idea
